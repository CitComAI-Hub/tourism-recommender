  {
    "id": "urn:ngsi-ld:PointOfInterest:node:2048687600",
    "type": "PointOfInterest",
    "name": "El Parotet",
    "location": {
      "type": "Point",
      "coordinates": [
        -0.353443,
        39.4601914
      ]
    },
    "category": [
      "artwork"
    ],
    "duration": 10,
    "image": "https://commons.wikimedia.org/wiki/Special:FilePath/Parotet.JPG?width=1200",
    "description": "El Parotet es un monumento muy conocido situado en la glorieta de Europa, al este de la ciudad de Valencia, cerca de la Ciutat de les Arts i les Ciències y la Torre de Francia. El nombre lo recibe por su semejanza al insecto libélula (parotet en valenciano).\nFue diseñado por el arquitecto valenciano Miquel Navarro y erigido en 2003. Es un regalo a la ciudad de la Fundació Caixa d'Estalvis i Mont de Pietat de València, que conmemora la creación de la Obra Social.\nTiene una altura de 46 metros.",
    "source": "https://www.openstreetmap.org",
    "refSeeAlso": [
      "Q9055725",
      "es:Parotet"
    ],
    "@context": [
      "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context.jsonld",
