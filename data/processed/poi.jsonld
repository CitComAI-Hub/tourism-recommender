    "id": "urn:ngsi-ld:PointOfInterest:way:227916537",
    "type": "PointOfInterest",
    "name": "Almodí",
    "location": {
      "type": "Point",
      "coordinates": [
        -0.3738657,
        39.4765751
      ]
