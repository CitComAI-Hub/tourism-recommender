  {
    "id": "urn:ngsi-ld:PointOfInterest:way:23807910",
    "type": "PointOfInterest",
    "name": "Parc Central",
    "location": {
      "type": "Point",
      "coordinates": [
        -0.3785091,
        39.4576146
